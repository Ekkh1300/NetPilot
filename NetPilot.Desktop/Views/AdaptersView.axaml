<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetPilot.Desktop.Views.AdaptersView">
  <Border Classes="card">
    <Grid RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0" Spacing="3">
        <TextBlock Classes="h2" Text="Adapters" />
        <TextBlock Classes="caption"
                   Text="Everything the system reports, including virtual adapters that are not a path to anywhere." />
      </StackPanel>
      <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
        <ItemsControl ItemsSource="{Binding Links}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="tile" Margin="0,0,0,6">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="caption" Text="{Binding Description}" />
                  </StackPanel>
                  <TextBlock Grid.Row="0" Grid.Column="1" Classes="caption" VerticalAlignment="Center"
                             Text="{Binding IsUp, StringFormat='up: {0}'}" />
                  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                              Spacing="16" Margin="0,6,0,0">
                    <TextBlock Classes="caption" Text="{Binding Kind, StringFormat='kind: {0}'}" />
                    <TextBlock Classes="caption" Text="{Binding Ipv4, StringFormat='ip: {0}'}" />
                    <TextBlock Classes="caption" Text="{Binding Rx, StringFormat='rx: {0} B'}" />
                    <TextBlock Classes="caption" Text="{Binding Tx, StringFormat='tx: {0} B'}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>