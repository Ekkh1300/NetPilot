<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetPilot.Desktop.Views.DnsView">
  <StackPanel Spacing="16">
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="DNS servers per interface" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Read live from the system. Changing them is only available where the platform backend allows it." />
        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Dns}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="tile" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,*">
                  <TextBlock Grid.Column="0" Text="{Binding AdapterName}" FontWeight="SemiBold" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="caption" Foreground="#FBBF24"
                               IsVisible="{Binding IsDynamic}"
                               Text="on DHCP" />
                    <TextBlock Classes="caption"
                               Text="{Binding Summary}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>