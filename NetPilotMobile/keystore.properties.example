# Release signing credentials for NetPilot (Android).
#
# This file is git-ignored. Copy it to keystore.properties, fill in your values and keep
# it on your own machine - never commit it. Anyone holding this keystore can ship an update
# that Android installs as if it came from us.
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore netpilot-release.jks -alias netpilot \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Every value can also come from an environment variable instead, which is what CI should
# use: NETPILOT_STORE_FILE, NETPILOT_STORE_PASSWORD, NETPILOT_KEY_ALIAS, NETPILOT_KEY_PASSWORD.
#
# The values below are placeholders. Put your real ones in keystore.properties, not here.

storeFile=CHANGE_ME.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME