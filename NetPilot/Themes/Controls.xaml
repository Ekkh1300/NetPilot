<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:NetPilot.Core">

    <!-- Shared converters are re-declared here on purpose (same reason as Pages.xaml):
         FrameworkTemplate content is re-parsed lazily with a parser scope that only
         covers this dictionary and the dictionaries merged before it, so a {StaticResource}
         that points at Application.Resources throws "Cannot find resource named ..."
         every single time the template is applied - the XamlParseException aborts
         ApplyTemplate halfway (half-rendered control) and gets logged on every measure
         pass, which is what filled crash.log. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <core:InverseBoolConverter x:Key="InvBool" />
    <core:NullToVisibilityConverter x:Key="NullToVis" />
    <core:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
    <core:ZeroToVisibilityConverter x:Key="ZeroToVis" />
    <core:ZeroToVisibilityConverter x:Key="NonZeroToVis" Invert="True" />
    <core:SpeedFormatConverter x:Key="SpeedFmt" />
    <core:ProgressFractionConverter x:Key="ProgressFrac" />

    <!-- ==================== Navigation item (radio-button styled row) ==================== -->
    <Style x:Key="S.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontFamily" Value="{StaticResource F.Main}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="row" Background="Transparent" CornerRadius="11"
                                Margin="8,3" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="glyph" Text="{TemplateBinding Tag}" Grid.Column="0"
                                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           FontSize="15" Foreground="{StaticResource B.Text2}"
                                           VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                        <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left"
                                Margin="0,8" Height="0" Background="{StaticResource B.Accent}"
                                VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="#14FFFFFF" />
                            <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="row" Property="Background" Value="#1F38BDF8" />
                            <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="bar" Property="Height" Value="22" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="row" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Toggle switch ==================== -->
    <Style x:Key="S.Toggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="23" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="track" Background="{StaticResource B.SurfaceAlt}"
                                BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                CornerRadius="12" />
                        <Ellipse x:Name="thumb" Width="17" Height="17" Fill="{StaticResource B.Text2}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="#5538BDF8" />
                            <Setter TargetName="thumb" Property="Fill" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Progress bar ==================== -->
    <Style x:Key="S.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="7" />
        <Setter Property="Background" Value="{StaticResource B.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{StaticResource B.AccentGrad}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Background="Transparent">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                        <Border x:Name="PART_Track" Background="Transparent" />
                        <!-- Width comes from Value/Maximum through ProgressFrac, so the
                             fill does not depend on theme-specific template parts. -->
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4"
                                RenderTransformOrigin="0,0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border.RenderTransform>
                                <ScaleTransform>
                                    <ScaleTransform.ScaleX>
                                        <MultiBinding Converter="{StaticResource ProgressFrac}">
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </ScaleTransform.ScaleX>
                                </ScaleTransform>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Chip / badge ==================== -->
    <Style x:Key="S.Chip" TargetType="Border">
        <Setter Property="Background" Value="#1AFFFFFF" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,4" />
    </Style>

    <!-- ==================== ScrollBar (dark) ==================== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3338BDF8" CornerRadius="4" Margin="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="10" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Page transition (fade + slide up) ==================== -->
    <Style x:Key="S.PageTransition" TargetType="FrameworkElement">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="10" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         To="0" Duration="0:0:0.28">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== ListBox row ==================== -->
    <Style x:Key="S.Row" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="10,8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#12FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1F38BDF8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== ToolTip ==================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource B.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="True" />
    </Style>

    <!-- ==================== List row (Border based, hover highlighted) ==================== -->
    <Style x:Key="S.ListRow" TargetType="Border">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#10FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== Caption (window) buttons ==================== -->
    <Style x:Key="S.CaptionBtn" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="S.CaptionClose" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#C50F1F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Segment / chip button ==================== -->
    <Style x:Key="S.SegBtn" TargetType="Button" BasedOn="{StaticResource S.Btn.Ghost}">
        <Setter Property="Padding" Value="13,6" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- ==================== Small label used above form fields ==================== -->
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ==================== Monospace value line ==================== -->
    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ==================== Hairline separator ==================== -->
    <Style x:Key="S.Separator" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Border}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,10" />
    </Style>

    <!-- ==================== Empty-state hint ==================== -->
    <Style x:Key="T.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,18" />
    </Style>

    <!-- ==================== Multiline read-only output box ==================== -->
    <Style x:Key="S.Multiline" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource B.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>

    <!-- ==================== Rounded outer frame for the page body ==================== -->
    <Style x:Key="S.PageHost" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Bg}" />
    </Style>

</ResourceDictionary>
