                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource S.Chip}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding LimitsSummary}" FontSize="11"
                                                           Foreground="{StaticResource B.Text2}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource S.Btn.Primary}" Padding="14,7"
                                                Content="{Binding Path=[pr_apply], Source={x:Static lang:Lang.Instance}}"
                                                Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource S.Btn.Ghost}" Padding="14,7" Margin="8,0,0,0"
                                                Content="{Binding Path=[copy], Source={x:Static lang:Lang.Instance}}"
                                                Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource S.Btn.Danger}" Padding="14,7" Margin="8,0,0,0"
                                                Content="{Binding Path=[delete], Source={x:Static lang:Lang.Instance}}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Lang[pr_no_profiles]}" Style="{StaticResource T.Hint}"
                           Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource T.Muted}" Margin="0,4,0,0" />

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ==================================================================
         14) Mobile VPN → PC
         ================================================================== -->
    <DataTemplate DataType="{x:Type vm:MobileVpnViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource S.PageTransition}">
            <StackPanel Margin="30,26,30,34">

                <DockPanel Margin="0,0,0,18" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding Lang[mv_title]}" Style="{StaticResource T.H1}" />
                        <TextBlock Text="{Binding Lang[mv_subtitle]}" Style="{StaticResource T.Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource S.Btn.Ghost}"
                            Content="{Binding Lang[refresh]}" Command="{Binding RefreshCommand}" />
                </DockPanel>

                <!-- status tiles -->
                <UniformGrid Columns="5">
                    <Border Style="{StaticResource S.Card}" Padding="16,14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[mv_h_mobile]}" Style="{StaticResource T.Muted}" FontSize="11.5" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Ellipse Width="9" Height="9" Fill="{Binding MobileBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MobileText}" Foreground="{Binding MobileBrush}"
                                           FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource S.Card}" Padding="16,14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[mv_h_phone_vpn]}" Style="{StaticResource T.Muted}" FontSize="11.5" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Ellipse Width="9" Height="9" Fill="{Binding MobileVpnBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MobileVpnText}" Foreground="{Binding MobileVpnBrush}"
                                           FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource S.Card}" Padding="16,14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[mv_h_pc_vpn]}" Style="{StaticResource T.Muted}" FontSize="11.5" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Ellipse Width="9" Height="9" Fill="{Binding PcVpnBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PcVpnText}" Foreground="{Binding PcVpnBrush}"
                                           FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource S.Card}" Padding="16,14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[mv_h_pc]}" Style="{StaticResource T.Muted}" FontSize="11.5" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Ellipse Width="9" Height="9" Fill="{Binding PcBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PcText}" Foreground="{Binding PcBrush}"
                                           FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource S.Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[mv_h_traffic]}" Style="{StaticResource T.Muted}" FontSize="11.5" />
                            <TextBlock Text="{Binding TrafficText}" Style="{StaticResource T.Mono}"
                                       FontSize="13" Foreground="{StaticResource B.Text}" Margin="0,7,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding Lang[mv_peers]}" FontSize="11"
                                           Foreground="{StaticResource B.Text2}" />
                                <TextBlock Text="{Binding PeerText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Accent}" Margin="5,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="372" />
                    </Grid.ColumnDefinitions>

                    <!-- transfer method + links -->
                    <Border Style="{StaticResource S.Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Lang[mv_links_card]}"
                                           Style="{StaticResource T.Section}" />
                                <Border DockPanel.Dock="Right" Style="{StaticResource S.Chip}">
                                    <TextBlock Text="{Binding SharingText}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{Binding SharingBrush}" />
                                </Border>
                            </DockPanel>

                            <TextBlock Text="{Binding Lang[mv_method]}" Style="{StaticResource T.Label}" Margin="0,10,0,6" />
                            <ComboBox Style="{StaticResource S.ComboBox}" ItemsSource="{Binding MethodOptions}"
                                      SelectedItem="{Binding SelectedMethod}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="{Binding Lang[mv_links]}" Style="{StaticResource T.Label}" Margin="0,14,0,6" />
                            <ListBox ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink}"
                                     ItemContainerStyle="{StaticResource S.Row}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="216">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding KindBrush}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource B.Text}"
                                                               FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="{StaticResource B.Text2}"
                                                           Margin="16,3,0,0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding KindLabel, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Ipv4, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{StaticResource B.Text2}" Margin="7,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding Lang[mv_no_links]}" Style="{StaticResource T.Hint}"
                                       Visibility="{Binding Links.Count, Converter={StaticResource ZeroToVis}}" />

                            <Border Style="{StaticResource S.Separator}" Margin="0,12,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource S.Btn.Primary}" Content="{Binding Lang[mv_share]}"
                                        Command="{Binding ShareCommand}" />
                                <Button Style="{StaticResource S.Btn.Danger}" Margin="10,0,0,0"
                                        Content="{Binding Lang[mv_stop_share]}" Command="{Binding StopCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- guard + backup + android bridge -->
                    <StackPanel Grid.Column="1">

                        <Border Style="{StaticResource S.Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[mv_guard_title]}" Style="{StaticResource T.Section}" />
                                <DockPanel LastChildFill="False" Margin="0,8,0,0">
                                    <StackPanel DockPanel.Dock="Left" MaxWidth="248" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Lang[mv_guard_confirm]}"
                                                   Foreground="{StaticResource B.Text}" FontSize="13"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Lang[mv_guard_body]}" Style="{StaticResource T.Muted}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource S.Toggle}"
                                                  IsChecked="{Binding ConfirmVpnChange}" VerticalAlignment="Top" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource S.Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[mv_backup_card]}" Style="{StaticResource T.Section}" />
                                <TextBlock Text="{Binding Lang[mv_backup_hint]}" Style="{StaticResource T.Muted}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Lang[mv_snapshot_at]}"
                                               Style="{StaticResource T.Muted}" />
                                    <TextBlock Text="{Binding SnapshotText}" Style="{StaticResource T.Mono}"
                                               Foreground="{StaticResource B.Text}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Lang[mv_snapshot_none]}" Style="{StaticResource T.Hint}"
                                           Visibility="{Binding HasSnapshot, Converter={StaticResource InvBoolToVis}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource S.Btn.AccentSoft}" Content="{Binding Lang[mv_capture]}"
                                            Command="{Binding CaptureCommand}" />
                                    <Button Style="{StaticResource S.Btn.Ghost}" Margin="10,0,0,0"
                                            Content="{Binding Lang[mv_restore]}" Command="{Binding RestoreCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource S.Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Lang[mv_api_title]}"
                                               Style="{StaticResource T.Section}" />
                                    <Border DockPanel.Dock="Right" Style="{StaticResource S.Chip}">
                                        <TextBlock Text="{Binding ApiStateText}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{Binding PairedBrush}" />
                                    </Border>
                                </DockPanel>

                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Lang[mv_api_address]}" Style="{StaticResource T.Label}" />
                                        <TextBlock Text="{Binding ApiAddress}" Style="{StaticResource T.Mono}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Lang[mv_pairing]}" Style="{StaticResource T.Label}" />
                                        <TextBlock Text="{Binding PairingCode}" Style="{StaticResource T.Mono}"
                                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource B.Accent}" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="{Binding Lang[mv_api_hint]}" Style="{StaticResource T.Hint}"
                                           Margin="0,10,0,0" TextWrapping="Wrap" />

                                <Border Style="{StaticResource S.Separator}" Margin="0,12,0,0" />

                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Lang[mv_device]}"
                                               Style="{StaticResource T.Muted}" />
                                    <TextBlock Text="{Binding DeviceText}" Foreground="{StaticResource B.Text}"
                                               FontSize="12" />
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Lang[mv_paired]}"
                                               Style="{StaticResource T.Muted}" />
                                    <TextBlock Text="{Binding PairedText}" Foreground="{Binding PairedBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Lang[mv_mobile_report]}"
                                               Style="{StaticResource T.Muted}" />
                                    <TextBlock Text="{Binding PhoneReport}" Foreground="{StaticResource B.Text}"
                                               FontSize="12" TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource S.Btn.Ghost}" Content="{Binding ApiToggleText}"
                                            Command="{Binding ToggleApiCommand}" />
                                    <Button Style="{StaticResource S.Btn.Ghost}" Margin="10,0,0,0"
                                            Content="{Binding Lang[mv_new_code]}" Command="{Binding NewCodeCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource T.Muted}" Margin="0,12,0,0" />

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ==================================================================
         15) Settings
         ================================================================== -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource S.PageTransition}">
            <StackPanel Margin="30,26,30,34">

                <TextBlock Text="{Binding Lang[settings]}" Style="{StaticResource T.H1}" />
                <TextBlock Text="{Binding Lang[st_saved]}" Style="{StaticResource T.Muted}" Margin="0,6,0,18" />

                <Border Style="{StaticResource S.Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Lang[language]}" Style="{StaticResource T.Section}" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Lang[st_language]}" Style="{StaticResource T.Label}" />
                                <ComboBox Style="{StaticResource S.ComboBox}" ItemsSource="{Binding LanguageOptions}"
                                          SelectedIndex="{Binding LanguageIndex}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[mon_target]}" Style="{StaticResource T.Label}" />
                                <TextBox Style="{StaticResource S.Input}"
                                         Text="{Binding MonitorTarget, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>

                        <Border Style="{StaticResource S.Separator}" />

                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{Binding Lang[st_minimize_to_tray]}" Foreground="{StaticResource B.Text}"
                                           FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Lang[st_tray_hint]}" Style="{StaticResource T.Muted}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource S.Toggle}"
                                          IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource S.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Lang[st_about]}" Style="{StaticResource T.Section}" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource B.AccentGrad}">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                           FontSize="20" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Lang[app_title]}" Foreground="{StaticResource B.Text}"
                                           FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource T.Muted}" Margin="0,2,0,0" />
                                <!-- Creator line: label localized, the name itself never translated. -->
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Lang[st_creator]}" Style="{StaticResource T.Muted}" />
                                    <TextBlock Text="esi" Style="{StaticResource T.Muted}" FontWeight="SemiBold"
                                               Foreground="{StaticResource B.Accent}" Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource T.Muted}" Margin="0,12,0,0" />

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
