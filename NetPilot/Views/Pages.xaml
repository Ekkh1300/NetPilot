<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:NetPilot.ViewModels"
                    xmlns:ctl="clr-namespace:NetPilot.Controls"
                    xmlns:core="clr-namespace:NetPilot.Core"
                    xmlns:lang="clr-namespace:NetPilot.Lang">

    <!-- Shared converters are re-declared here on purpose. FrameworkTemplate content is
         re-parsed lazily (LoadTemplateXaml) with a fresh parser scope that only covers
         this dictionary, so {StaticResource} to Application.Resources fails at that
         moment with "Cannot find resource named ...". The resulting XamlParseException
         aborts ApplyTemplate halfway and leaves the page half-rendered. Keeping the keys
         in this dictionary makes every lookup below resolve locally. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <core:InverseBoolConverter x:Key="InvBool" />
    <!-- Bool -> Visibility with the value flipped. InvBool answers with a bool, which
         WPF cannot cast to Visibility, so it must never be used on that property. -->
    <core:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
    <core:NullToVisibilityConverter x:Key="NullToVis" />
    <core:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
    <core:ZeroToVisibilityConverter x:Key="ZeroToVis" />
    <core:ZeroToVisibilityConverter x:Key="NonZeroToVis" Invert="True" />
    <core:SpeedFormatConverter x:Key="SpeedFmt" />
    <core:ProgressFractionConverter x:Key="ProgressFrac" />

    <!-- ==================================================================
         1) Dashboard
         ================================================================== -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource S.PageTransition}">
            <StackPanel Margin="30,26,30,34">

                <TextBlock Text="{Binding Lang[dashboard]}" Style="{StaticResource T.H1}" />
                <TextBlock Text="{Binding HealthState}" Style="{StaticResource T.Muted}" Margin="0,6,0,20" />

                <!-- KPI tiles -->
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource S.Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[mon_download_speed]}" Style="{StaticResource T.Muted}" />
                            <TextBlock Text="{Binding DownText}" Style="{StaticResource T.Value}"
                                       Margin="0,6,0,0" Foreground="#38BDF8" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource S.Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[mon_upload_speed]}" Style="{StaticResource T.Muted}" />
                            <TextBlock Text="{Binding UpText}" Style="{StaticResource T.Value}"
                                       Margin="0,6,0,0" Foreground="#818CF8" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource S.Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[db_today]}" Style="{StaticResource T.Muted}" />
                            <TextBlock Text="{Binding TodayText}" Style="{StaticResource T.Value}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[db_top_app_now]}" Style="{StaticResource T.Muted}" />
                            <TextBlock Text="{Binding TopApp}" Style="{StaticResource T.H2}"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Health + live activity -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource S.Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[db_health]}" Style="{StaticResource T.Section}" />

                            <Grid Margin="0,4,0,0">
                                <ctl:DonutGauge Width="158" Height="158" MaxValue="100"
                                                Value="{Binding Score}" Fill="{Binding ScoreBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ScoreText}" Style="{StaticResource T.Value}"
                                               Foreground="{Binding ScoreBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Lang[db_health]}" Style="{StaticResource T.Muted}"
                                               HorizontalAlignment="Center" FontSize="11" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource S.Separator}" />

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Lang[db_dns]}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DnsDetail}" FontSize="12" Margin="10,0"
                                           Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource S.Chip}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding DnsRating}" Foreground="{StaticResource B.Text}" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Lang[db_latency]}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding LatDetail}" FontSize="12" Margin="10,0"
                                           Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource S.Chip}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding LatRating}" Foreground="{StaticResource B.Text}" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Lang[db_packet_loss]}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding LossDetail}" FontSize="12" Margin="10,0"
                                           Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource S.Chip}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding LossRating}" Foreground="{StaticResource B.Text}" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Lang[db_connection]}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ConnDetail}" FontSize="12" Margin="10,0"
                                           Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Style="{StaticResource S.Chip}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ConnRating}" Foreground="{StaticResource B.Text}" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource S.Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding Lang[db_activity]}" Style="{StaticResource T.Section}" DockPanel.Dock="Left" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Style="{StaticResource S.Chip}">
                                        <TextBlock Text="{Binding DownText}" Foreground="#38BDF8" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Style="{StaticResource S.Chip}" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding UpText}" Foreground="#818CF8" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="176" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ctl:OrbControl Width="152" Height="152"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                DownBps="{Binding OrbDown}" UpBps="{Binding OrbUp}"
                                                State="{Binding OrbState}" />
                                <ctl:SpeedChart Grid.Column="1" Margin="6,0,0,0"
                                                DownValues="{Binding ChartDown}" UpValues="{Binding ChartUp}" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Lang[dns_current]}" Style="{StaticResource T.Muted}" />
                                        <TextBlock Text="{Binding CurrentDns}" Style="{StaticResource T.Mono}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Lang[nh_top_app]}" Style="{StaticResource T.Muted}" />
                                        <TextBlock Text="{Binding TopApp}" Style="{StaticResource T.Mono}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Quick actions -->
                <Border Style="{StaticResource S.Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Lang[db_quick_actions]}" Style="{StaticResource T.Section}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource S.Btn.AccentSoft}" Command="{Binding GoDnsCommand}"
                                    Content="{Binding Lang[db_quick_switch]}" />
                            <Button Style="{StaticResource S.Btn.Ghost}" Margin="10,0,0,0"
                                    Command="{Binding GoBenchmarkCommand}" Content="{Binding Lang[db_run_benchmark]}" />
                            <Button Style="{StaticResource S.Btn.Ghost}" Margin="10,0,0,0"
                                    Command="{Binding GoHistoryCommand}" Content="{Binding Lang[db_view_history]}" />
                            <Button Style="{StaticResource S.Btn.Ghost}" Margin="10,0,0,0"
                                    Command="{Binding GoToolsCommand}" Content="{Binding Lang[db_open_tools]}" />
                            <Button Style="{StaticResource S.Btn.Ghost}" Margin="10,0,0,0"
                                    Command="{Binding GoMonitorCommand}" Content="{Binding Lang[network_monitor]}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ==================================================================
         2) DNS Manager
         ================================================================== -->
    <DataTemplate DataType="{x:Type vm:DnsManagerViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource S.PageTransition}">
            <StackPanel Margin="30,26,30,34">

                <DockPanel Margin="0,0,0,18" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding Lang[dns_manager]}" Style="{StaticResource T.H1}" />
                        <TextBlock Text="{Binding Lang[dns_current]}" Style="{StaticResource T.Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource S.Btn.Ghost}" Command="{Binding RestoreCommand}"
                                Content="{Binding Lang[restore]}" />
                        <Button Style="{StaticResource S.Btn.Ghost}" Margin="10,0,0,0" Command="{Binding FlushCommand}"
                                Content="{Binding Lang[nt_flush_dns]}" />
                        <Button Style="{StaticResource S.Btn.Ghost}" Margin="10,0,0,0" Command="{Binding RefreshCommand}"
                                Content="{Binding Lang[refresh]}" />
                    </StackPanel>
                </DockPanel>

                <Border Style="{StaticResource S.Card}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="270" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[dns_servers_list]}" Style="{StaticResource T.Section}" />
                            <TextBlock Text="{Binding CurrentDnsSummary}" Style="{StaticResource T.Mono}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Text="{Binding Lang[dns_adapter]}" Style="{StaticResource T.Label}" />
                            <!-- Explicit ItemTemplate: the custom ComboBox template shows the
                                 selection box through SelectionBoxItemTemplate, which is only
                                 populated from ItemTemplate; DisplayMemberPath would leave it
                                 null and the box would fall back to object.ToString(). -->
                            <ComboBox Style="{StaticResource S.ComboBox}" ItemsSource="{Binding Adapters}"
                                      SelectedItem="{Binding SelectedAdapter}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Style="{StaticResource S.Input}"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding Lang[dns_search_ph]}" Margin="11,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="{StaticResource B.Text2}" FontSize="13"
                                   Visibility="{Binding Search, Converter={StaticResource NullToVis}}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource S.Toggle}" IsChecked="{Binding FavOnly}" />
                        <TextBlock Text="{Binding Lang[dns_favorites_only]}" Style="{StaticResource T.Muted}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource S.Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Lang[dns_provider]}" Style="{StaticResource T.Section}" />
                        <ListBox ItemsSource="{Binding Filtered}"
                                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource S.Row}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34" CornerRadius="11" Background="#16FFFFFF"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       FontSize="15" Foreground="{Binding Color}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource B.Text}"
                                                           FontSize="13.5" FontWeight="SemiBold" />
                                                <Border Style="{StaticResource S.Chip}" Margin="8,0,0,0"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Path=[current], Source={x:Static lang:Lang.Instance}}"
                                                               FontSize="10.5" Foreground="{StaticResource B.Accent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Servers}" FontSize="11.5"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       Foreground="{StaticResource B.Text2}" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <ToggleButton Grid.Column="2" Style="{StaticResource S.Toggle}"
                                                      VerticalAlignment="Center" IsChecked="{Binding IsFavorite}"
                                                      ToolTip="{Binding Path=[favorite], Source={x:Static lang:Lang.Instance}}"
                                                      Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                      CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding Lang[dns_select_hint]}" Style="{StaticResource T.Hint}"
                                   Visibility="{Binding NoEntries, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource S.Btn.Primary}" Command="{Binding ApplyCommand}"
                            Content="{Binding Lang[apply]}" MinWidth="130" />
                    <Button Style="{StaticResource S.Btn.Ghost}" Margin="10,0,0,0" Command="{Binding ShowCustomCommand}"
                            Content="{Binding Lang[dns_add_custom]}" />
                </StackPanel>

                <Border Style="{StaticResource S.Card}" Margin="0,14,0,0"
                        Visibility="{Binding ShowCustomForm, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Lang[dns_add_custom]}" Style="{StaticResource T.Section}" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Lang[dns_custom_name]}" Style="{StaticResource T.Label}" />
                                <TextBox Style="{StaticResource S.Input}" Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Lang[dns_primary]}" Style="{StaticResource T.Label}" />
                                <TextBox Style="{StaticResource S.Input}" Text="{Binding CustomPrimary, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[dns_secondary]}" Style="{StaticResource T.Label}" />
                                <TextBox Style="{StaticResource S.Input}" Text="{Binding CustomSecondary, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource S.Btn.Primary}" Command="{Binding AddCustomCommand}"
                                    Content="{Binding Lang[add]}" />
                            <Button Style="{StaticResource S.Btn.Ghost}" Margin="10,0,0,0" Command="{Binding ShowCustomCommand}"
                                    Content="{Binding Lang[cancel]}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource T.Muted}" Margin="0,12,0,0" />

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ==================================================================
         3) DNS Benchmark
         ================================================================== -->
    <DataTemplate DataType="{x:Type vm:BenchmarkViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource S.PageTransition}">
            <StackPanel Margin="30,26,30,34">

                <TextBlock Text="{Binding Lang[dns_benchmark]}" Style="{StaticResource T.H1}" />
                <TextBlock Text="{Binding Lang[bm_compare_note]}" Style="{StaticResource T.Muted}" Margin="0,6,0,18" />

                <Border Style="{StaticResource S.Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding Lang[bm_rounds]}" Style="{StaticResource T.Label}" />
                                <ComboBox Style="{StaticResource S.ComboBox}" Width="110"
                                          ItemsSource="{Binding RoundsOptions}" SelectedItem="{Binding Rounds}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text=" " Style="{StaticResource T.Label}" />
                                <Button Style="{StaticResource S.Btn.Primary}" Content="{Binding Lang[bm_run]}"
                                        Command="{Binding RunCommand}" IsEnabled="{Binding NotRunning}" MinWidth="150" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                <TextBlock Text=" " Style="{StaticResource T.Label}" />
                                <Button Style="{StaticResource S.Btn.Danger}" Content="{Binding Lang[bm_stop]}"
                                        Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Lang[bm_best_hint]}" Style="{StaticResource T.Muted}" />
                                <TextBlock Text="{Binding BestText}" Style="{StaticResource T.H2}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar Style="{StaticResource S.Progress}" Margin="0,16,0,0"
                                     Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource T.Muted}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource S.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Lang[bm_chart]}" Style="{StaticResource T.Section}" />
                        <ctl:HBarChart Items="{Binding ChartItems}" Height="230" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Lang[bm_no_results]}" Style="{StaticResource T.Hint}"
                                   Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource S.Card}" Margin="0,14,0,0"
                        Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Lang[bm_results]}" Style="{StaticResource T.Section}" />
                        <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                                 ItemContainerStyle="{StaticResource S.Row}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="30" Height="30" CornerRadius="10" Background="#16FFFFFF"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       FontSize="14" Foreground="{Binding Color}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <Border Grid.Column="1" Style="{StaticResource S.Chip}" HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource B.AccentGrad}">
                                            <TextBlock Text="{Binding RankText}" Foreground="White" FontWeight="Bold" FontSize="11.5" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource B.Text}"
                                                       FontSize="13.5" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Path=[bm_avg], Source={x:Static lang:Lang.Instance}}"
                                                       Style="{StaticResource T.Muted}" FontSize="10.5" />
                                            <TextBlock Text="{Binding AvgText}" Foreground="{StaticResource B.Text}"
                                                       FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Path=[bm_packet_loss], Source={x:Static lang:Lang.Instance}}"
                                                       Style="{StaticResource T.Muted}" FontSize="10.5" />
                                            <TextBlock Text="{Binding LossText}" Foreground="{StaticResource B.Text}" FontSize="13" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Path=[bm_response_time], Source={x:Static lang:Lang.Instance}}"
                                                       Style="{StaticResource T.Muted}" FontSize="10.5" />
                                            <TextBlock Text="{Binding PingText}" Foreground="{StaticResource B.Text}" FontSize="13" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ==================================================================
         4) Smart DNS
         ================================================================== -->
    <DataTemplate DataType="{x:Type vm:SmartDnsViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource S.PageTransition}">
            <StackPanel Margin="30,26,30,34">

                <TextBlock Text="{Binding Lang[smart_dns]}" Style="{StaticResource T.H1}" />
                <TextBlock Text="{Binding Lang[sd_title]}" Style="{StaticResource T.Muted}" Margin="0,6,0,18" />

                <Border Style="{StaticResource S.Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource S.Btn.Primary}" Content="{Binding Lang[sd_scan]}"
                                    Command="{Binding ScanCommand}" IsEnabled="{Binding NotScanning}" MinWidth="180" />
                            <Button Style="{StaticResource S.Btn.Ghost}" Margin="10,0,0,0"
                                    Content="{Binding Lang[sd_apply_suggested]}"
                                    Command="{Binding ApplyCommand}" IsEnabled="{Binding NotScanning}" />
                        </StackPanel>

                        <ProgressBar Style="{StaticResource S.Progress}" Margin="0,16,0,0"
                                     Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource T.Muted}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource S.Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[sd_current_dns]}" Style="{StaticResource T.Muted}" />
