                    </Border>

                    <Border Style="{StaticResource S.Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[sd_recommendation]}" Style="{StaticResource T.Muted}" />
                            <TextBlock Text="{Binding Recommendation}" Style="{StaticResource T.H2}"
