                    </Border>

                    <Border Style="{StaticResource S.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[sd_improvement]}" Style="{StaticResource T.Muted}" />
                                <TextBlock Text="{Binding ImprovementText}" Style="{StaticResource T.Value}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Lang[sd_faster_count]}" Style="{StaticResource T.Muted}" />
                                <TextBlock Text="{Binding FasterCount}" Style="{StaticResource T.Value}" Margin="0,4,0,0" />
