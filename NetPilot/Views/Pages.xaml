                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ==================================================================
         5) Network Monitor
         ================================================================== -->
    <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource S.PageTransition}">
            <StackPanel Margin="30,26,30,34">

                <DockPanel Margin="0,0,0,18" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding Lang[network_monitor]}" Style="{StaticResource T.H1}" />
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource T.Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource S.Chip}" Background="#1F38BDF8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource B.Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Lang[mon_live]}" Foreground="{StaticResource B.Accent}"
                                       FontSize="11.5" FontWeight="Bold" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                </DockPanel>

                <Border Style="{StaticResource S.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="230" />
                        </Grid.RowDefinitions>

                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{Binding Lang[mon_download_speed]}" Style="{StaticResource T.Muted}" />
                                <TextBlock Text="{Binding DownText}" Style="{StaticResource T.Value}"
                                           Margin="0,4,0,0" Foreground="#38BDF8" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{Binding Lang[mon_upload_speed]}" Style="{StaticResource T.Muted}" />
                                <TextBlock Text="{Binding UpText}" Style="{StaticResource T.Value}"
                                           Margin="0,4,0,0" Foreground="#818CF8" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{Binding Lang[mon_ping]}" Style="{StaticResource T.Muted}" />
                                <TextBlock Text="{Binding PingText}" Style="{StaticResource T.Value}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[mon_packet_loss]}" Style="{StaticResource T.Muted}" />
                                <TextBlock Text="{Binding LossText}" Style="{StaticResource T.Value}" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="196" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ctl:OrbControl Width="176" Height="176"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            DownBps="{Binding OrbDown}" UpBps="{Binding OrbUp}"
                                            State="{Binding OrbState}" />
                            <ctl:SpeedChart Grid.Column="1" Margin="6,0,0,0"
                                            DownValues="{Binding ChartDown}" UpValues="{Binding ChartUp}" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource S.Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[mon_uptime]}" Style="{StaticResource T.Muted}" />
                            <TextBlock Text="{Binding UptimeText}" Style="{StaticResource T.H2}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource S.Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[mon_total_down]}" Style="{StaticResource T.Muted}" />
                            <TextBlock Text="{Binding SessionDownText}" Style="{StaticResource T.H2}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource S.Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[mon_total_up]}" Style="{StaticResource T.Muted}" />
                            <TextBlock Text="{Binding SessionUpText}" Style="{StaticResource T.H2}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource S.Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding Lang[mon_target]}" Style="{StaticResource T.Label}" />
                            <TextBox Style="{StaticResource S.Input}" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ==================================================================
         6) Per-App Usage
         ================================================================== -->
    <DataTemplate DataType="{x:Type vm:PerAppViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource S.PageTransition}">
            <StackPanel Margin="30,26,30,34">

                <DockPanel Margin="0,0,0,18" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding Lang[per_app_usage]}" Style="{StaticResource T.H1}" />
                        <TextBlock Text="{Binding Lang[pa_desc]}" Style="{StaticResource T.Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource S.Chip}">
                        <TextBlock Text="{Binding TotalCount}" Foreground="{StaticResource B.Text}" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                </DockPanel>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Style="{StaticResource S.Input}"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding Lang[pa_search_ph]}" Margin="11,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="{StaticResource B.Text2}" FontSize="13"
                                   Visibility="{Binding Search, Converter={StaticResource NullToVis}}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource S.SegBtn}" Content="{Binding Lang[download]}"
                                Command="{Binding SortCommand}" CommandParameter="down" />
                        <Button Style="{StaticResource S.SegBtn}" Margin="8,0,0,0" Content="{Binding Lang[upload]}"
                                Command="{Binding SortCommand}" CommandParameter="up" />
                        <Button Style="{StaticResource S.SegBtn}" Margin="8,0,0,0" Content="{Binding Lang[total]}"
                                Command="{Binding SortCommand}" CommandParameter="total" />
                        <Button Style="{StaticResource S.SegBtn}" Margin="8,0,0,0" Content="{Binding Lang[pa_connections]}"
                                Command="{Binding SortCommand}" CommandParameter="conn" />
                        <Button Style="{StaticResource S.SegBtn}" Margin="8,0,0,0" Content="{Binding Lang[name]}"
                                Command="{Binding SortCommand}" CommandParameter="name" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource S.Card}">
                    <StackPanel>
                        <!-- column headers -->
                        <Grid Margin="4,0,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="" />
                            <TextBlock Grid.Column="1" Text="{Binding Lang[pa_app]}" Style="{StaticResource T.Label}" Margin="0" />
                            <TextBlock Grid.Column="2" Text="{Binding Lang[pa_down_speed]}" Style="{StaticResource T.Label}" Margin="0" />
                            <TextBlock Grid.Column="3" Text="{Binding Lang[pa_up_speed]}" Style="{StaticResource T.Label}" Margin="0" />
                            <TextBlock Grid.Column="4" Text="{Binding Lang[pa_total_down]}" Style="{StaticResource T.Label}" Margin="0" />
                            <TextBlock Grid.Column="5" Text="{Binding Lang[pa_total_up]}" Style="{StaticResource T.Label}" Margin="0" />
                            <TextBlock Grid.Column="6" Text="{Binding Lang[pa_connections]}" Style="{StaticResource T.Label}" Margin="0" />
                        </Grid>

                        <Border Style="{StaticResource S.Separator}" Margin="0,0,0,6" />

                        <Border MaxHeight="560">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource S.ListRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="30" Height="30" CornerRadius="10" Background="#16FFFFFF"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                                   FontSize="14" Foreground="{StaticResource B.Accent}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource B.Text}"
                                                                       FontSize="13.5" FontWeight="SemiBold" />
                                                            <Border Style="{StaticResource S.Chip}" Margin="8,0,0,0"
                                                                    Background="#2EF87171"
                                                                    Visibility="{Binding StatusTag, Converter={StaticResource NotNullToVis}}">
                                                                <TextBlock Text="{Binding StatusTag}" Foreground="#F87171" FontSize="10.5" FontWeight="Bold" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource B.Text2}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding DownText}" VerticalAlignment="Center"
                                                               Foreground="#38BDF8" FontSize="13" />
                                                    <TextBlock Grid.Column="3" Text="{Binding UpText}" VerticalAlignment="Center"
                                                               Foreground="#818CF8" FontSize="13" />
                                                    <TextBlock Grid.Column="4" Text="{Binding TotalDownText}" VerticalAlignment="Center"
                                                               Foreground="{StaticResource B.Text}" FontSize="13" />
                                                    <TextBlock Grid.Column="5" Text="{Binding TotalUpText}" VerticalAlignment="Center"
                                                               Foreground="{StaticResource B.Text}" FontSize="13" />
                                                    <TextBlock Grid.Column="6" Text="{Binding Connections}" VerticalAlignment="Center"
                                                               Foreground="{StaticResource B.Text2}" FontSize="13" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="{Binding Lang[pa_no_data]}" Style="{StaticResource T.Hint}"
                                   Visibility="{Binding TotalCount, Converter={StaticResource ZeroToVis}}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource T.Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ==================================================================
         7) Net Limiter
         ================================================================== -->
    <DataTemplate DataType="{x:Type vm:NetLimiterViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource S.PageTransition}">
            <StackPanel Margin="30,26,30,34">

                <TextBlock Text="{Binding Lang[net_limiter]}" Style="{StaticResource T.H1}" />
                <TextBlock Text="{Binding Lang[nl_current_processes]}" Style="{StaticResource T.Muted}" Margin="0,6,0,18" />

                <Border Style="{StaticResource S.Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Lang[nl_add_rule]}" Style="{StaticResource T.Section}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[nl_app_path]}" Style="{StaticResource T.Label}" />
                                <ComboBox Style="{StaticResource S.ComboBox}" ItemsSource="{Binding Apps}"
                                          SelectedItem="{Binding SelectedApp}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                <TextBlock Text=" " Style="{StaticResource T.Label}" />
                                <Button Style="{StaticResource S.Btn.Ghost}" Content="{Binding Lang[nl_browse]}"
                                        Command="{Binding BrowseCommand}" Margin="0,22,0,0" />
                                <Button Style="{StaticResource S.Btn.Ghost}" Margin="8,22,0,0"
                                        Content="{Binding Lang[refresh]}" Command="{Binding RefreshAppsCommand}" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="3" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Lang[nl_mode]}" Style="{StaticResource T.Label}" />
                                <ComboBox Style="{StaticResource S.ComboBox}" ItemsSource="{Binding ModeOptions}"
                                          SelectedIndex="{Binding ModeIndex}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Lang[nl_down_limit]}" Style="{StaticResource T.Label}" />
                                <ComboBox Style="{StaticResource S.ComboBox}" ItemsSource="{Binding PresetOptions}"
                                          SelectedItem="{Binding SelectedDownPreset}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Lang[nl_up_limit]}" Style="{StaticResource T.Label}" />
                                <ComboBox Style="{StaticResource S.ComboBox}" ItemsSource="{Binding PresetOptions}"
                                          SelectedItem="{Binding SelectedUpPreset}" />
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,12,0,0"
                                     Visibility="{Binding DownIsCustom, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Lang[custom]}" Style="{StaticResource T.Label}" />
                                <TextBox Style="{StaticResource S.Input}" Text="{Binding CustomDown, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding UpIsCustom, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Lang[custom]}" Style="{StaticResource T.Label}" />
                                <TextBox Style="{StaticResource S.Input}" Text="{Binding CustomUp, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource S.Btn.Primary}" Content="{Binding Lang[nl_add_rule]}"
                                    Command="{Binding AddCommand}" MinWidth="150" />
                            <Border Style="{StaticResource S.Chip}" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ModeDescription}" Foreground="{StaticResource B.Accent}"
                                           FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource S.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Lang[nl_rules]}" Style="{StaticResource T.Section}" />
                        <ListBox ItemsSource="{Binding Rules}" ItemContainerStyle="{StaticResource S.Row}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="30" Height="30" CornerRadius="10" Background="#16FFFFFF"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       FontSize="14" Foreground="{Binding AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource B.Text}"
                                                       FontSize="13.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource B.Text2}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Style="{StaticResource S.Chip}" VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding ModeText}" Foreground="{Binding AccentBrush}"
                                                       FontSize="11.5" FontWeight="Bold" />
                                        </Border>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Path=[nl_down_limit], Source={x:Static lang:Lang.Instance}}"
                                                       Style="{StaticResource T.Muted}" FontSize="10.5" />
                                            <TextBlock Text="{Binding DownText}" Foreground="{StaticResource B.Text}" FontSize="13" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Path=[nl_up_limit], Source={x:Static lang:Lang.Instance}}"
                                                       Style="{StaticResource T.Muted}" FontSize="10.5" />
                                            <TextBlock Text="{Binding UpText}" Foreground="{StaticResource B.Text}" FontSize="13" />
                                        </StackPanel>

                                        <Button Grid.Column="5" Style="{StaticResource S.Btn.Danger}"
                                                Content="{Binding Path=[remove], Source={x:Static lang:Lang.Instance}}"
                                                Padding="12,6" FontSize="12"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding Lang[nl_no_rules]}" Style="{StaticResource T.Hint}"
                                   Visibility="{Binding Rules.Count, Converter={StaticResource ZeroToVis}}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource T.Muted}" Margin="0,12,0,0" />

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

