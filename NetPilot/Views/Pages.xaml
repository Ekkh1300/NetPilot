                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{StaticResource B.Accent}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" FontSize="12"
                                                   Margin="10,0,0,0" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource S.Card}" Margin="0,14,0,0"
                        Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Lang[bm_results]}" Style="{StaticResource T.Section}" />
                        <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}"
                                 ItemContainerStyle="{StaticResource S.Row}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="10" Background="#16FFFFFF"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                                       FontSize="14" Foreground="{Binding Color}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource B.Text}"
                                                       FontSize="13.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Path=[bm_packet_loss], Source={x:Static lang:Lang.Instance}}"
                                                       Style="{StaticResource T.Muted}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource S.Chip}" VerticalAlignment="Center"
                                                Background="{DynamicResource B.AccentGrad}">
                                            <TextBlock Text="{Binding RankText}" Foreground="White" FontWeight="Bold" FontSize="11.5" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding AvgText}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource B.Text}"
